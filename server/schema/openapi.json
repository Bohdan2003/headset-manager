        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/CommandView"
                  },
                  "title": "Response Update Over Wifi Api Setup Update Wifi Post"
