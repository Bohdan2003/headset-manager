    "/api/agent/apk": {
      "get": {
        "summary": "Agent Apk",
        "description": "В APK нет секретов, а поставить его можно только поверх агента с той же подписью.",
        "operationId": "agent_apk_api_agent_apk_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    }
