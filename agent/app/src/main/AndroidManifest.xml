<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Системное право: выдаётся один раз через `pm grant` в provision.sh -->
    <uses-permission
        android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <!-- Заряд контроллеров (dumpsys OVRRemoteService); выдаётся в provision.sh через pm grant -->
    <uses-permission
        android:name="android.permission.DUMP"
        tools:ignore="ProtectedPermissions" />

    <!-- Последнее открытое приложение после перезапуска агента; выдаётся в provision.sh через appops -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- Android 11+: без этого агент не видит игры и не может их запускать -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- VR-приложения: по этой категории отличаем игры от 2D-приложений -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="com.oculus.intent.category.VR" />
        </intent>
    </queries>

    <!-- usesCleartextTraffic: сервер в локальной сети арены, ws:// без TLS -->
    <application
        android:name=".AgentApp"
        android:label="Arena Agent"
        android:allowBackup="false"
        android:usesCleartextTraffic="true">

        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <!-- после обновления агента (adb install -r) система его останавливает -->
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Настройка из provision.sh. Защищено DUMP: отправить может shell (adb) -->
        <receiver
            android:name=".ProvisionReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.arena.agent.PROVISION" />
                <action android:name="com.arena.agent.PROVISION_KEY" />
                <action android:name="com.arena.agent.PROVISION_PING" />
            </intent-filter>
        </receiver>

        <!-- «Наше меню» — экран ожидания между играми -->
        <activity
            android:name=".MenuActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:label="Arena" />

        <service
            android:name=".AgentService"
            android:exported="false" />

        <service
            android:name=".WatcherService"
            android:exported="true"
            android:label="Arena Agent: current game"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_config" />
        </service>
    </application>
</manifest>
