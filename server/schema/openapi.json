    "/api/setup/update-wifi": {
      "post": {
        "summary": "Update Over Wifi",
        "description": "Агенты сами скачают новую версию с этого сервера и установят её через локальный ADB.",
        "operationId": "update_over_wifi_api_setup_update_wifi_post",
        "parameters": [
          {
            "name": "authorization",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "default": "",
              "title": "Authorization"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WifiUpdateRequest"
              }
            }
          }
