  "components": {
    "schemas": {
      "AppInfo": {
        "properties": {
          "package": {
            "type": "string",
            "title": "Package"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "vr": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Vr"
          }
        },
        "type": "object",
        "required": [
          "package",
          "title",
          "vr"
        ],
        "title": "AppInfo"
      },
      "AuthRequest": {
        "properties": {
          "password": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "password"
        ],
        "title": "AuthRequest"
      },
      "AuthStatus": {
        "properties": {
          "configured": {
            "type": "boolean",
            "title": "Configured"
          },
          "authenticated": {
            "type": "boolean",
            "title": "Authenticated"
          },
          "canSetup": {
            "type": "boolean",
            "title": "Cansetup"
          }
        },
        "type": "object",
        "required": [
          "configured",
          "authenticated",
          "canSetup"
        ],
        "title": "AuthStatus"
      },
      "CommandCreate": {
        "properties": {
          "headsetIds": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 200,
            "minItems": 1,
            "title": "Headsetids"
          },
          "cmd": {
            "type": "string",
            "enum": [
              "launch",
              "show_menu",
              "set_sleep",
              "guard",
              "close_game",
              "restart_game",
              "reboot",
              "sleep",
              "power_off",
              "request_access",
              "update_agent"
            ],
            "title": "Cmd"
          },
          "params": {
            "additionalProperties": true,
            "type": "object",
            "title": "Params"
          },
          "ttlS": {
            "type": "integer",
            "maximum": 60.0,
            "minimum": 1.0,
            "title": "Ttls",
            "default": 10
          }
        },
        "type": "object",
        "required": [
          "headsetIds",
          "cmd"
        ],
        "title": "CommandCreate",
        "description": "Запрос дашборда: одна команда нескольким шлемам."
      },
      "CommandView": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "headsetId": {
            "type": "string",
            "title": "Headsetid"
          },
          "cmd": {
            "type": "string",
            "enum": [
              "launch",
              "show_menu",
              "set_sleep",
              "guard",
              "close_game",
              "restart_game",
              "reboot",
              "sleep",
              "power_off",
              "request_access",
              "update_agent"
            ],
            "title": "Cmd"
          },
          "params": {
            "additionalProperties": true,
            "type": "object",
            "title": "Params"
          },
          "status": {
            "type": "string",
            "enum": [
              "sent",
              "acked",
              "failed",
              "timeout"
            ],
            "title": "Status"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "offline",
                  "asleep",
                  "timeout",
                  "no_adb",
                  "not_allowed",
                  "failed",
                  "expired",
                  "bad_params"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          },
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Detail"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "title": "Createdat"
          },
          "ackedAt": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ackedat"
          }
        },
        "type": "object",
        "required": [
          "id",
          "headsetId",
          "cmd",
          "params",
          "status",
          "reason",
          "detail",
          "createdAt",
          "ackedAt"
        ],
        "title": "CommandView",
        "description": "Команда одному шлему и её судьба."
      },
      "ControllerInfo": {
        "properties": {
          "side": {
            "type": "string",
            "enum": [
              "left",
              "right"
            ],
            "title": "Side"
          },
          "battery": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 100.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Battery"
          },
          "connected": {
            "type": "boolean",
            "title": "Connected"
          }
        },
        "type": "object",
        "required": [
          "side",
          "battery",
          "connected"
        ],
        "title": "ControllerInfo"
      },
      "FleetHeadset": {
        "properties": {
          "headsetId": {
            "type": "string",
            "title": "Headsetid"
          },
          "label": {
            "type": "string",
            "title": "Label"
          },
          "online": {
            "type": "boolean",
            "title": "Online"
          },
          "agentVersion": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Agentversion"
          },
          "adb": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "ready",
                  "no_wifi",
                  "waiting_confirmation",
                  "connecting",
                  "key_missing",
                  "key_rejected",
                  "error"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Adb"
          },
          "status": {
            "type": "string",
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "headsetId",
          "label",
          "online",
          "agentVersion",
          "adb",
          "status"
        ],
        "title": "FleetHeadset",
        "description": "Шлем в базе: можно ли обновить его по Wi-Fi."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HeadsetCreate": {
        "properties": {
          "label": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "Label"
          },
          "serial": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "Serial"
          },
          "androidId": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Androidid"
          }
        },
        "type": "object",
        "required": [
          "label",
          "serial"
        ],
        "title": "HeadsetCreate"
      },
      "HeadsetCredentials": {
        "properties": {
          "headsetId": {
            "type": "string",
            "title": "Headsetid"
          },
          "token": {
            "type": "string",
            "title": "Token"
          },
          "created": {
            "type": "boolean",
            "title": "Created"
          }
        },
        "type": "object",
        "required": [
          "headsetId",
          "token",
          "created"
        ],
        "title": "HeadsetCredentials",
        "description": "Ответ на регистрацию: это передаётся агенту при настройке. Токен показывается один раз."
      },
      "HeadsetRename": {
        "properties": {
          "label": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "Label"
          }
        },
        "type": "object",
        "required": [
          "label"
        ],
        "title": "HeadsetRename"
      },
      "HeadsetView": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "label": {
            "type": "string",
            "title": "Label"
          },
          "serial": {
            "type": "string",
            "title": "Serial"
          },
          "online": {
            "type": "boolean",
            "title": "Online",
            "default": false
          },
          "battery": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Battery"
          },
          "charging": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Charging"
          },
          "temp": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Temp"
          },
          "currentPkg": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Currentpkg"
          },
          "adb": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "ready",
                  "no_wifi",
                  "waiting_confirmation",
                  "connecting",
                  "key_missing",
                  "key_rejected",
                  "error"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Adb"
          },
          "sleepDisabled": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sleepdisabled"
          },
          "agentVersion": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Agentversion"
          },
          "lastSeen": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Lastseen"
          },
          "guardPkg": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
