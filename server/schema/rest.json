{
  "$defs": {
    "AuthStatus": {
      "properties": {
        "configured": {
          "title": "Configured",
          "type": "boolean"
        },
        "authenticated": {
          "title": "Authenticated",
          "type": "boolean"
        },
        "canSetup": {
          "title": "Cansetup",
          "type": "boolean"
        }
      },
      "required": [
        "configured",
        "authenticated",
        "canSetup"
      ],
      "title": "AuthStatus",
      "type": "object"
    },
    "CommandCreate": {
      "description": "Запрос дашборда: одна команда нескольким шлемам.",
      "properties": {
        "headsetIds": {
          "items": {
            "type": "string"
          },
          "maxItems": 200,
          "minItems": 1,
          "title": "Headsetids",
          "type": "array"
        },
        "cmd": {
          "enum": [
            "launch",
            "show_menu",
            "set_sleep",
            "guard",
            "close_game",
            "restart_game",
            "reboot",
            "sleep",
            "power_off",
            "request_access",
            "update_agent"
          ],
          "title": "Cmd",
          "type": "string"
        },
        "params": {
          "additionalProperties": true,
          "title": "Params",
          "type": "object"
        },
        "ttlS": {
          "default": 10,
          "maximum": 60,
          "minimum": 1,
          "title": "Ttls",
          "type": "integer"
        }
      },
      "required": [
        "headsetIds",
        "cmd",
        "params",
        "ttlS"
      ],
      "title": "CommandCreate",
      "type": "object"
    },
    "CommandView": {
      "description": "Команда одному шлему и её судьба.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "headsetId": {
          "title": "Headsetid",
          "type": "string"
        },
        "cmd": {
          "enum": [
            "launch",
            "show_menu",
            "set_sleep",
            "guard",
            "close_game",
            "restart_game",
            "reboot",
            "sleep",
            "power_off",
            "request_access",
            "update_agent"
          ],
          "title": "Cmd",
          "type": "string"
        },
        "params": {
          "additionalProperties": true,
          "title": "Params",
          "type": "object"
        },
        "status": {
          "enum": [
            "sent",
            "acked",
            "failed",
            "timeout"
          ],
          "title": "Status",
          "type": "string"
        },
        "reason": {
          "anyOf": [
            {
              "enum": [
                "offline",
                "asleep",
                "timeout",
                "no_adb",
                "not_allowed",
                "failed",
                "expired",
                "bad_params"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "detail": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Detail"
        },
        "createdAt": {
          "format": "date-time",
          "title": "Createdat",
          "type": "string"
        },
        "ackedAt": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ackedat"
        }
      },
      "required": [
        "id",
        "headsetId",
        "cmd",
        "params",
        "status",
        "reason",
        "detail",
        "createdAt",
        "ackedAt"
      ],
      "title": "CommandView",
      "type": "object"
    },
    "FleetHeadset": {
      "description": "Шлем в базе: можно ли обновить его по Wi-Fi.",
      "properties": {
        "headsetId": {
          "title": "Headsetid",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "online": {
          "title": "Online",
          "type": "boolean"
        },
        "agentVersion": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Agentversion"
        },
        "adb": {
          "anyOf": [
            {
              "enum": [
                "ready",
                "no_wifi",
                "waiting_confirmation",
                "connecting",
                "key_missing",
                "key_rejected",
                "error"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Adb"
        },
        "status": {
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "headsetId",
        "label",
        "online",
        "agentVersion",
        "adb",
        "status"
      ],
      "title": "FleetHeadset",
      "type": "object"
    },
